# ── Database ──────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=landjepa
POSTGRES_USER=landjepa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Demo Mode ─────────────────────────────────────────────────────────
# Set to true during development. Must be false in production.
DEMO_MODE=true

# ── Alert Safety ──────────────────────────────────────────────────────
# When true, no real SMS/push/email alerts are sent. Only demo logging.
ALERT_DEMO_ONLY=true

# ── ML ────────────────────────────────────────────────────────────────
ML_DEVICE=cpu
# ML_DEVICE=cuda  # uncomment if GPU is available
ML_CHECKPOINTS_DIR=ml/checkpoints

# ── Data Providers ────────────────────────────────────────────────────
# Options: 'demo' | 'open_meteo' | 'era5' | 'imd' | ...
RAINFALL_PROVIDER=demo
WEATHER_PROVIDER=open_meteo
SOIL_MOISTURE_PROVIDER=demo
TERRAIN_PROVIDER=demo
INSAR_ENABLED=false

# ── External API Keys (only needed for non-demo providers) ────────────
# OPEN_METEO_API_KEY=        # Open-Meteo is free, no key needed
# USGS_API_KEY=              # USGS earthquake feed is free, no key needed
# CDS_API_KEY=               # ERA5 via CDS API
# NASA_EARTHDATA_TOKEN=      # NASA Earthdata token for satellite rainfall / SMAP
# MAPTILER_API_KEY=          # MapTiler Cloud key for satellite & topographic GIS tiles

# ── Scheduling ────────────────────────────────────────────────────────
RAINFALL_REFRESH_INTERVAL_MINUTES=60
WEATHER_REFRESH_INTERVAL_MINUTES=60
SOIL_MOISTURE_REFRESH_INTERVAL_MINUTES=1440
RISK_RECOMPUTE_INTERVAL_MINUTES=60

# ── File Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_PHOTO_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# ── Early Warning SMS & Push Notifications (SIH26001) ──────────────────
# SMS Provider choice: 'twilio' | 'msg91' | 'aws_sns' | 'fast2sms' | 'mock'
# If left empty or unset, system marks status as NOT_CONFIGURED (no false claims)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=LNDJPA
SMS_TEMPLATE_ID=

# Push Notification choice: 'webpush' | 'fcm' | 'mock'
PUSH_PROVIDER=webpush
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:ops@landjepa.gov.in
FCM_SERVER_KEY=

# Safety & Testing:
# When NOTIFICATION_TEST_MODE=true, real notifications are restricted to verified test recipients
NOTIFICATION_TEST_MODE=true
NOTIFICATION_TEST_PHONE=+919876543210
NOTIFICATION_WEBHOOK_SECRET=landjepa-webhook-secret-2026

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_DEMO_MODE=true
VITE_MAPTILER_API_KEY=

