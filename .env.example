# =====================================================================
# LAND-JEPA — Environment Configuration Template (.env.example)
# Never commit actual secret keys or credentials to version control.
# Copy this file to .env and populate with your credentials.
# On Render: Set these variables in the Render Dashboard Environment tab.
# =====================================================================

# ── Port & Server (Render dynamic PORT) ───────────────────────────────
PORT=8000

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────
# Standard Render Database URL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=landjepa
POSTGRES_USER=landjepa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend Security & JWT ───────────────────────────────────────────
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sih26001-cuk1.onrender.com

# ── Operational Modes ────────────────────────────────────────────────
# Set DEMO_MODE=true for demonstration/simulation data fallback
DEMO_MODE=true
# When ALERT_DEMO_ONLY=true, no real SMS/push/email alerts are sent
ALERT_DEMO_ONLY=true

# ── Machine Learning ─────────────────────────────────────────────────
ML_DEVICE=cpu
ML_CHECKPOINTS_DIR=ml/checkpoints

# ── External Provider Selection ──────────────────────────────────────
# Options: 'demo' | 'open_meteo' | 'era5' | 'imd' | ...
RAINFALL_PROVIDER=demo
WEATHER_PROVIDER=open_meteo
SOIL_MOISTURE_PROVIDER=demo
TERRAIN_PROVIDER=demo
INSAR_ENABLED=false

# ── External API Credentials ─────────────────────────────────────────
# OpenWeather API (current telemetry and 5-day / 3-hour forecasts)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
WEATHER_PRIMARY_PROVIDER=openweather  # 'openweather' | 'open_meteo' | 'existing'

# Open-Meteo API (free public NWP, optional key for commercial tier)
OPEN_METEO_API_KEY=

# Esri ArcGIS Developer Services (Origin restricted in Esri Dashboard)
ARCGIS_API_KEY=YOUR_ARCGIS_DEVELOPER_API_KEY
ARCGIS_ORIGIN=https://sih26001-cuk1.onrender.com

# Ultralytics Computer Vision Platform (YOLOv8 Citizen Hazard Verification)
ULTRALYTICS_API_KEY=YOUR_ULTRALYTICS_API_KEY

# India Meteorological Department (IMD) AWS / Radar Telemetry
IMD_API_KEY=YOUR_IMD_CREDENTIALS_IF_APPLICABLE

# USGS Earthquake Hazards API (Public feed, key optional)
USGS_API_KEY=

# Copernicus Data Space / NASA Earthdata (Sentinel-1 InSAR & SMAP)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=

# MapTiler Cloud (Satellite & Topographic basemaps)
MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# ── Citizen Vision (Ultralytics YOLOv8 Subsystem) ─────────────────────
CITIZEN_VISION_MODEL_PATH=ml/checkpoints/citizen_vision/best.pt
CITIZEN_VISION_CONFIDENCE_THRESHOLD=0.25
CITIZEN_VISION_IOU_THRESHOLD=0.45
CITIZEN_VISION_DATASET_DIR=data/datasets
CITIZEN_VISION_MODEL_VERSION=citizen-vision-v1

# ── Scheduling & Polling Intervals ────────────────────────────────────
RAINFALL_REFRESH_INTERVAL_MINUTES=60
WEATHER_REFRESH_INTERVAL_MINUTES=60
SOIL_MOISTURE_REFRESH_INTERVAL_MINUTES=1440
RISK_RECOMPUTE_INTERVAL_MINUTES=60

# ── File Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_PHOTO_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50

# ── Early Warning SMS & Push Notifications ────────────────────────────
# SMS Provider choice: 'twilio' | 'msg91' | 'aws_sns' | 'fast2sms' | 'mock'
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=LNDJPA
SMS_TEMPLATE_ID=

# Push Notification choice: 'webpush' | 'fcm' | 'mock'
PUSH_PROVIDER=webpush
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:ops@landjepa.gov.in
FCM_SERVER_KEY=

# Safety & Testing:
NOTIFICATION_TEST_MODE=true
NOTIFICATION_TEST_PHONE=+919876543210
NOTIFICATION_WEBHOOK_SECRET=landjepa-webhook-secret-2026

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cloudflare Tunnel & Public Access Configuration ───────────────────
# Public base URL for the FastAPI backend exposed via Cloudflare Tunnel
LAND_JEPA_API_BASE_URL=https://api.yourdomain.com
CLOUDFLARE_API_HOSTNAME=api.yourdomain.com

# ── Mobile Application Configuration (React Native / Expo) ────────────
EXPO_PUBLIC_API_URL=https://api.yourdomain.com

