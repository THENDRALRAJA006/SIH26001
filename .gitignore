# LAND-JEPA — .gitignore

# ── Environment & Secrets ────────────────────────────────────────────
.env
*.env
.env.local
.env.*.local
*.pem
*.key
.cloudflared/
*credentials.json
cert.pem
*.tunnel-token

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node / Frontend ───────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
mobile/node_modules/
.expo/
.expo-shared/

# ── ML Artifacts ─────────────────────────────────────────────────────
# Allow essential production checkpoints to be tracked for deployment
!ml/checkpoints/
!ml/checkpoints/**
!yolov8n.pt
/models/
!ml/models/
*.pt
*.pkl
*.joblib
*.h5
# Explicitly whitelist vital production model checkpoints
!ml/checkpoints/**/*.pt
!ml/checkpoints/**/*.pkl
!ml/checkpoints/**/*.json
runs/

# ── Data ──────────────────────────────────────────────────────────────
data/raw/
data/interim/
data/processed/
data/uploads/
data/datasets/
data/hard_negatives/
# Keep: data/demo/ and data/.gitkeep files

# ── Results (large files) ─────────────────────────────────────────────
results/experiment_logs/
results/*.png
results/*.csv
# Keep: results/FINAL_RESEARCH_REPORT.md

# ── Database ──────────────────────────────────────────────────────────
*.sql.gz
pgdata/

# ── Docker ────────────────────────────────────────────────────────────
docker/volumes/

# ── IDE / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── Logs ──────────────────────────────────────────────────────────────
*.log
logs/

# ── Alembic ───────────────────────────────────────────────────────────
# Keep migrations, exclude generated dumps

# ── Temporary Prompt Dumps ───────────────────────────────────────────
prompt_dump*.txt

